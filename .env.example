# URL de l'API backend (visible côté client)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# true (ou absent) : données de démo locales ; false : appels à l'API réelle (endpoints du contrat docs/API_CONTRACT_V2.1.md)
NEXT_PUBLIC_USE_MOCKS=true

# NextAuth (obligatoire en production — générer avec : openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
