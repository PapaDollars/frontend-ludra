# URL de l'API backend (visible côté client)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# true (ou absent) : données de démo locales
# mixed : routes déjà livrées par le backend en réel (src/lib/liveEndpoints.ts), le reste en démo — mode de production actuel
# false : tout en réel (quand le backend couvre tout docs/API_CONTRACT_V2.1.md)
NEXT_PUBLIC_USE_MOCKS=mixed

# NextAuth (obligatoire en production — générer avec : openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
